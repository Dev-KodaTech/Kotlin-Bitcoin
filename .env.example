# Copy to .env and fill in. Never commit real values.

# Active Spring profiles (dev | test | prod)
SPRING_PROFILES_ACTIVE=dev

# JWT HS256 secret: at least 32 bytes (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# Quote source (Mercado Bitcoin v1). With the "stub" compose profile: http://quote-stub:8080/api/BTC/ticker/
QUOTE_PROVIDER_URL=https://www.mercadobitcoin.net/api/BTC/ticker/

# E-mail: Brevo in prod; SMTP (Mailpit) in dev
BREVO_API_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025

# PostgreSQL
DB_URL=jdbc:postgresql://postgres:5432/kotlinbitcoins
DB_USER=
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
MAIL_FROM=
